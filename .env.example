# Copy to .env for host-run development; docker-compose.yml hardcodes the
# same values for the container topology. Never commit a real .env.

# PostgreSQL (docker-compose.yml service "db", host port 5432;
# docker-compose.test.yml service "db-test", host port 5433).
POSTGRES_USER=patrol
POSTGRES_PASSWORD=patrol
POSTGRES_DB=patrol
DATABASE_URL=postgres://patrol:patrol@localhost:5432/patrol
TEST_DATABASE_URL=postgres://patrol:patrol@localhost:5433/patrol_test

# Object store for evidence blobs (docker-compose.yml service "minio",
# host port 9000; docker-compose.test.yml service "minio-test", port 9002).
PATROL_OBJECT_STORE_ENDPOINT=http://localhost:9000
PATROL_OBJECT_STORE_ACCESS_KEY=patrolminio
PATROL_OBJECT_STORE_SECRET_KEY=patrolminio
# The bucket the worker creates (versioned) on first boot; defaults to
# patrol-evidence. Region defaults to us-east-1.
PATROL_OBJECT_STORE_BUCKET=patrol-evidence

# Contactable address for the upstream User-Agents (Wikidata in the API,
# DataForSEO in the worker). Required in production.
PATROL_CONTACT_EMAIL=

# Outbound mail (invitations, resets, and the operator alert emails). With
# PATROL_SMTP_HOST set, the API and the worker send through the relay;
# without it both fall back to the console transport. The from address is
# required once a host is configured. Port defaults to 587; port 465 (or
# PATROL_SMTP_SECURE=1) selects implicit TLS.
PATROL_SMTP_HOST=
PATROL_SMTP_PORT=587
PATROL_SMTP_USER=
PATROL_SMTP_PASS=
PATROL_SMTP_FROM=

# The operator mailbox the budget-alert and submission-reminder emails land
# in. Falls back to PATROL_CONTACT_EMAIL when unset; unset entirely and the
# alert rows still fire — the dashboard surfaces them, only the email is
# skipped.
PATROL_ALERT_EMAIL=

# Worker acquisition: "1" replaces the real provider routes with the
# fixture-driven fake adapter (docker-compose.yml sets this for the worker
# by default; unset it and provide DATAFORSEO_LOGIN/DATAFORSEO_PASSWORD
# and YANDEX_SEARCH_API_KEY/YANDEX_FOLDER_ID for real routes).
PATROL_FAKE_ADAPTER=1

# Deployment environment: "dev" by default; slice-0 stub routes mount only
# outside "production".
PATROL_ENV=dev

# General API rate limits (in-memory fixed windows, per process): a
# per-session ceiling for authenticated calls and a per-IP ceiling for
# anonymous ones, answering 429 rate_limited with retryAfterSeconds. The
# health probe is exempt; the sign-in lockout throttle is separate.
PATROL_RATE_LIMIT_WINDOW_SECONDS=60
PATROL_RATE_LIMIT_SESSION_MAX=600
PATROL_RATE_LIMIT_ANONYMOUS_MAX=120
