# Copy to .env for host-run development; docker-compose.yml hardcodes the
# same values for the container topology. Never commit a real .env.

# PostgreSQL (docker-compose.yml service "db", host port 5432;
# docker-compose.test.yml service "db-test", host port 5433).
POSTGRES_USER=patrol
POSTGRES_PASSWORD=patrol
POSTGRES_DB=patrol
DATABASE_URL=postgres://patrol:patrol@localhost:5432/patrol
TEST_DATABASE_URL=postgres://patrol:patrol@localhost:5433/patrol_test

# Object store for evidence blobs (docker-compose.yml service "minio",
# host port 9000; docker-compose.test.yml service "minio-test", port 9002).
PATROL_OBJECT_STORE_ENDPOINT=http://localhost:9000
PATROL_OBJECT_STORE_ACCESS_KEY=patrolminio
PATROL_OBJECT_STORE_SECRET_KEY=patrolminio

# Deployment environment: "dev" by default; slice-0 stub routes mount only
# outside "production".
PATROL_ENV=dev
