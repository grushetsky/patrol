{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "patrol-domain",
    "$defs": {
        "PostalAddress": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/PostalAddress.json",
            "type": "object",
            "properties": {
                "line1": {
                    "type": "string",
                    "description": "The first address line."
                },
                "line2": {
                    "type": "string",
                    "description": "The second address line, when the address needs one."
                },
                "city": {
                    "type": "string",
                    "description": "The city or locality."
                },
                "region": {
                    "type": "string",
                    "description": "The state, province, or region, where the country uses one."
                },
                "postalCode": {
                    "type": "string",
                    "description": "The postal code."
                },
                "country": {
                    "$ref": "https://patrol.example/schemas/CountryCode.json",
                    "description": "The country of the address."
                }
            },
            "required": [
                "line1",
                "city",
                "postalCode",
                "country"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A contact or legal postal address."
        },
        "CountryCode": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/CountryCode.json",
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "An ISO 3166-1 alpha-2 country code, uppercase."
        },
        "CaptureProfile": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/CaptureProfile.json",
            "type": "object",
            "properties": {
                "userAgent": {
                    "type": "string",
                    "description": "The user agent Patrol identified itself with."
                },
                "viewportWidth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "The viewport width in CSS pixels."
                },
                "viewportHeight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "The viewport height in CSS pixels."
                },
                "locale": {
                    "$ref": "https://patrol.example/schemas/Locale.json",
                    "description": "The locale the browser was configured with."
                },
                "timezone": {
                    "$ref": "https://patrol.example/schemas/TimeZoneId.json",
                    "description": "The browser's time zone."
                },
                "javascriptEnabled": {
                    "type": "boolean",
                    "description": "Whether JavaScript ran before the DOM and screenshot were taken."
                },
                "blockedResourceKinds": {
                    "type": "array",
                    "items": {
                        "$ref": "https://patrol.example/schemas/ResourceKind.json"
                    },
                    "description": "Request kinds the capture blocked."
                },
                "navigationPolicy": {
                    "type": "string",
                    "description": "The navigation and readiness policy, such as a load plus settle rather than network idle."
                },
                "extractorVersion": {
                    "type": "string",
                    "description": "The extractor version that produced the extraction sidecar."
                }
            },
            "required": [
                "userAgent",
                "viewportWidth",
                "viewportHeight",
                "locale",
                "timezone",
                "javascriptEnabled",
                "blockedResourceKinds",
                "navigationPolicy",
                "extractorVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The browser and extraction settings of one capture, without which the capture cannot be explained or repeated."
        },
        "Locale": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Locale.json",
            "type": "string",
            "description": "A BCP 47 language tag with an optional territory, such as ru-RU."
        },
        "TimeZoneId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TimeZoneId.json",
            "type": "string",
            "description": "An IANA time zone identifier, such as Europe/Berlin."
        },
        "ResourceKind": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/ResourceKind.json",
            "type": "string",
            "enum": [
                "media",
                "websocket",
                "service_worker",
                "advertising",
                "third_party_analytics"
            ],
            "description": "Kinds of requests a capture blocks."
        },
        "RedirectHop": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/RedirectHop.json",
            "type": "object",
            "properties": {
                "url": {
                    "$ref": "https://patrol.example/schemas/Url.json",
                    "description": "The URL of this hop."
                },
                "statusCode": {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647,
                    "description": "The status code this hop returned."
                },
                "location": {
                    "type": "string",
                    "description": "The Location header this hop returned, when it redirected."
                }
            },
            "required": [
                "url",
                "statusCode"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "One HTTP hop in a redirect chain."
        },
        "Url": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Url.json",
            "type": "string",
            "format": "uri",
            "description": "An absolute HTTP or HTTPS URL, stored verbatim unless a field says otherwise."
        },
        "IntentPhrase": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/IntentPhrase.json",
            "type": "object",
            "properties": {
                "text": {
                    "type": "string",
                    "description": "The phrase appended to the display title, in the locale's language."
                },
                "version": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "The version of the phrase at issue time."
                }
            },
            "required": [
                "text",
                "version"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "An intent phrase an operator can edit, carrying the version a search result was issued under."
        },
        "OperatorAttestation": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/OperatorAttestation.json",
            "type": "object",
            "properties": {
                "attestedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the operator attested."
                },
                "statementVersion": {
                    "type": "string",
                    "description": "The version of the attestation statement the operator agreed to."
                }
            },
            "required": [
                "attestedAt",
                "statementVersion"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "An operator's attestation that a notice was filed as presented."
        },
        "RightsHolder": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/RightsHolder.json",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "https://patrol.example/schemas/RightsHolderId.json",
                    "description": "Patrol's own identifier."
                },
                "legalName": {
                    "type": "string",
                    "description": "The rights holder's legal name, as it appears on a notice."
                },
                "country": {
                    "$ref": "https://patrol.example/schemas/CountryCode.json",
                    "description": "The country of the rights holder's address."
                },
                "address": {
                    "$ref": "https://patrol.example/schemas/PostalAddress.json",
                    "description": "The rights holder's postal address."
                },
                "roleMailbox": {
                    "$ref": "https://patrol.example/schemas/Email.json",
                    "description": "The role mailbox a recipient may contact about a notice."
                },
                "phone": {
                    "type": "string",
                    "description": "A phone number, where a recipient's form asks for one."
                },
                "signatory": {
                    "$ref": "https://patrol.example/schemas/Signatory.json",
                    "description": "The natural person authorised to sign notices."
                },
                "acquisitionBudget": {
                    "$ref": "https://patrol.example/schemas/AcquisitionBudget.json",
                    "description": "The acquisition cap and its per-engine split."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the rights holder row was created."
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the rights holder row was last edited."
                }
            },
            "required": [
                "id",
                "legalName",
                "country",
                "address",
                "roleMailbox",
                "signatory",
                "acquisitionBudget",
                "createdAt",
                "updatedAt"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The legal person on whose behalf Patrol identifies violations and signs notices. Exactly one exists per deployment."
        },
        "RightsHolderId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/RightsHolderId.json",
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the single rights holder in the deployment."
        },
        "Email": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Email.json",
            "type": "string",
            "format": "email",
            "description": "An email address."
        },
        "Signatory": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Signatory.json",
            "type": "object",
            "properties": {
                "fullLegalName": {
                    "type": "string",
                    "description": "The signatory's full legal name, rendered in every signature field."
                },
                "authorityBasis": {
                    "type": "string",
                    "description": "The basis on which the signatory is authorised to act for the rights holder."
                },
                "contactEmail": {
                    "$ref": "https://patrol.example/schemas/Email.json",
                    "description": "The signatory's contact email, snapshotted into a notice at approval."
                },
                "contactPhone": {
                    "type": "string",
                    "description": "The signatory's contact phone, where a form asks for one."
                }
            },
            "required": [
                "fullLegalName",
                "authorityBasis",
                "contactEmail"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The natural person authorised to sign notices. It holds no credentials and cannot sign in."
        },
        "AcquisitionBudget": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/AcquisitionBudget.json",
            "type": "object",
            "properties": {
                "engineCaps": {
                    "type": "array",
                    "items": {
                        "$ref": "https://patrol.example/schemas/EngineBudgetCap.json"
                    },
                    "description": "The cap for each engine. Bing is deferred and carries a zero cap until it is added."
                },
                "recheckSharePercent": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "The percentage of each engine allowance reserved for re-checks, defaulting to 30."
                }
            },
            "required": [
                "engineCaps",
                "recheckSharePercent"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "The monthly acquisition cap and the share reserved for re-checks."
        },
        "EngineBudgetCap": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/EngineBudgetCap.json",
            "type": "object",
            "properties": {
                "engine": {
                    "$ref": "https://patrol.example/schemas/Engine.json",
                    "description": "The engine the cap applies to."
                },
                "currency": {
                    "$ref": "https://patrol.example/schemas/Currency.json",
                    "description": "The currency of the cap."
                },
                "monthlyCapMinor": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483647,
                    "description": "The monthly cap in the currency's minor unit, such as cents."
                }
            },
            "required": [
                "engine",
                "currency",
                "monthlyCapMinor"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "One engine's monthly cap and the billable units it buys."
        },
        "Engine": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Engine.json",
            "type": "string",
            "enum": [
                "google",
                "bing",
                "yandex"
            ],
            "description": "A search source that returns results for a query."
        },
        "Currency": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Currency.json",
            "type": "string",
            "enum": [
                "usd"
            ],
            "description": "A currency Patrol's acquisition cap supports."
        },
        "TitleGroup": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleGroup.json",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "https://patrol.example/schemas/TitleGroupId.json",
                    "description": "Patrol's own identifier."
                },
                "name": {
                    "type": "string",
                    "description": "The group's display name."
                },
                "locales": {
                    "type": "array",
                    "items": {
                        "$ref": "https://patrol.example/schemas/Locale.json"
                    },
                    "description": "The locales the group's scans generate queries for. At least one locale is required."
                },
                "scanTime": {
                    "type": "string",
                    "format": "time",
                    "description": "The local time inside the scheduling window at which the group becomes due. The window is 02:00 to 05:59 UTC by default."
                },
                "priority": {
                    "$ref": "https://patrol.example/schemas/GroupPriority.json",
                    "description": "The group's scheduling priority."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the group was created."
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the group was last edited."
                }
            },
            "required": [
                "id",
                "name",
                "locales",
                "scanTime",
                "priority",
                "createdAt",
                "updatedAt"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "An operator-defined set of tracked titles that share scan settings and allowlist scope."
        },
        "TitleGroupId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleGroupId.json",
            "type": "string",
            "format": "uuid",
            "description": "Identifier of an operator-defined title group."
        },
        "GroupPriority": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/GroupPriority.json",
            "type": "string",
            "enum": [
                "high",
                "normal",
                "low"
            ],
            "description": "The scheduling priority of a title group."
        },
        "TrackedTitle": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TrackedTitle.json",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "https://patrol.example/schemas/TrackedTitleId.json",
                    "description": "Patrol's own identifier. Never an external identifier."
                },
                "titleGroupId": {
                    "$ref": "https://patrol.example/schemas/TitleGroupId.json",
                    "description": "The one title group the title belongs to."
                },
                "releaseYear": {
                    "type": "integer",
                    "minimum": 1878,
                    "maximum": 2147483647,
                    "description": "The four-digit year of first release; for a series, the year of the first season's first episode."
                },
                "titleType": {
                    "$ref": "https://patrol.example/schemas/TitleType.json",
                    "description": "The kind of work."
                },
                "runtimeMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647,
                    "description": "The runtime in minutes; for a series, the typical episode runtime. Absent when unknown."
                },
                "originalVariantId": {
                    "$ref": "https://patrol.example/schemas/TitleVariantId.json",
                    "description": "The variant whose text is the canonical label and display title. Exactly one variant of the title is original."
                },
                "paused": {
                    "type": "boolean",
                    "description": "Whether scanning is paused for this title. A paused title is excluded from the chart's tracked count."
                },
                "mergedIntoTitleId": {
                    "$ref": "https://patrol.example/schemas/TrackedTitleId.json",
                    "description": "When the title was merged into another, the surviving title. A merged title is archived, never deleted."
                },
                "provenance": {
                    "$ref": "https://patrol.example/schemas/TitleProvenance.json",
                    "description": "Where the original title, year, and type came from, and who entered them."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the title was created."
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the title was last edited."
                }
            },
            "required": [
                "id",
                "titleGroupId",
                "releaseYear",
                "titleType",
                "originalVariantId",
                "paused",
                "provenance",
                "createdAt",
                "updatedAt"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A work the rights holder monitors, carrying its original title, release year, title type, runtime, external identifiers, and title variants."
        },
        "TrackedTitleId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TrackedTitleId.json",
            "type": "string",
            "format": "uuid",
            "description": "Identifier of a tracked title."
        },
        "TitleType": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleType.json",
            "type": "string",
            "enum": [
                "film",
                "series",
                "miniseries",
                "other"
            ],
            "description": "The kind of work a tracked title is."
        },
        "TitleVariantId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleVariantId.json",
            "type": "string",
            "format": "uuid",
            "description": "Identifier of a title variant."
        },
        "TitleProvenance": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleProvenance.json",
            "type": "object",
            "properties": {
                "source": {
                    "$ref": "https://patrol.example/schemas/CatalogueSource.json",
                    "description": "Where the original title, year, and type came from."
                },
                "enteredBy": {
                    "$ref": "https://patrol.example/schemas/OperatorId.json",
                    "description": "The operator who entered the title."
                },
                "enteredAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the operator entered the title."
                },
                "updatedBy": {
                    "$ref": "https://patrol.example/schemas/OperatorId.json",
                    "description": "The operator who last edited the title."
                }
            },
            "required": [
                "source",
                "enteredBy",
                "enteredAt",
                "updatedBy"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "Provenance of a tracked title's core facts."
        },
        "CatalogueSource": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/CatalogueSource.json",
            "type": "string",
            "enum": [
                "rights_holder_record",
                "operator_knowledge",
                "wikidata"
            ],
            "description": "Where a catalogue value came from."
        },
        "OperatorId": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/OperatorId.json",
            "type": "string",
            "format": "uuid",
            "description": "Identifier of an operator account."
        },
        "TitleVariant": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleVariant.json",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "https://patrol.example/schemas/TitleVariantId.json",
                    "description": "Patrol's own identifier."
                },
                "trackedTitleId": {
                    "$ref": "https://patrol.example/schemas/TrackedTitleId.json",
                    "description": "The tracked title the variant belongs to."
                },
                "text": {
                    "type": "string",
                    "description": "The variant text as the operator entered it. The native string is never overwritten."
                },
                "normalizedText": {
                    "type": "string",
                    "description": "The matching key derived from the text by the normalization rules. Never typed, never displayed."
                },
                "kind": {
                    "$ref": "https://patrol.example/schemas/TitleVariantKind.json",
                    "description": "How the variant relates to the work."
                },
                "language": {
                    "$ref": "https://patrol.example/schemas/Locale.json",
                    "description": "The language tag of the text."
                },
                "script": {
                    "$ref": "https://patrol.example/schemas/ScriptCode.json",
                    "description": "The script the text is written in."
                },
                "territory": {
                    "$ref": "https://patrol.example/schemas/Territory.json",
                    "description": "The territory the variant applies to, when it is territory-specific."
                },
                "source": {
                    "$ref": "https://patrol.example/schemas/CatalogueSource.json",
                    "description": "Where the variant text came from."
                },
                "addedBy": {
                    "$ref": "https://patrol.example/schemas/OperatorId.json",
                    "description": "The operator who added the variant."
                },
                "addedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the variant was added."
                }
            },
            "required": [
                "id",
                "trackedTitleId",
                "text",
                "normalizedText",
                "kind",
                "language",
                "script",
                "source",
                "addedBy",
                "addedAt"
            ],
            "unevaluatedProperties": {
                "not": {}
            },
            "description": "A recorded string by which a tracked title is known, typed by kind, language, script, and territory."
        },
        "TitleVariantKind": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/TitleVariantKind.json",
            "type": "string",
            "enum": [
                "original",
                "localized",
                "transliterated",
                "alternate"
            ],
            "description": "How a title variant relates to the work."
        },
        "ScriptCode": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/ScriptCode.json",
            "type": "string",
            "pattern": "^[A-Z][a-z]{3}$",
            "description": "An ISO 15924 script code, such as Latn or Cyrl."
        },
        "Territory": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/Territory.json",
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "An ISO 3166-1 alpha-2 territory code, uppercase, used where a rule applies to a country rather than a language."
        },
        "ExternalIdentifier": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "https://patrol.example/schemas/ExternalIdentifier.json",
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "https://patrol.example/schemas/ExternalIdentifierId.json",
                    "description": "Patrol's own identifier for the row."
                },
                "trackedTitleId": {
                    "$ref": "https://patrol.example/schemas/TrackedTitleId.json",
                    "description": "The tracked title the identifier belongs to."
                },
                "scheme": {
                    "$ref": "https://patrol.example/schemas/ExternalIdentifierScheme.json",
                    "description": "The scheme the value belongs to."
                },
                "value": {
                    "type": "string",
                    "description": "The identifier value in that scheme."
                },
                "source": {
