{
  "name": "patrol",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "contract:check": "npm --prefix contract run check",
    "contract:verify": "npm --prefix contract run verify",
    "contract:types": "openapi-typescript contract/generated/openapi/Patrol.openapi.yaml -o apps/web/src/generated/openapi.d.ts",
    "dev:api": "pnpm --filter @patrol/api dev",
    "dev:web": "pnpm --filter @patrol/web dev"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
