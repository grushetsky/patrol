{
  "name": "@patrol/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker process for pg-boss queues and evidence capture.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@patrol/budget": "workspace:*",
    "@patrol/db": "workspace:*",
    "@patrol/domain": "workspace:*",
    "@patrol/evidence": "workspace:*",
    "@patrol/scans": "workspace:*",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^10.4.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
