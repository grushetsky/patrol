{
  "name": "@patrol/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bootstrap": "tsx src/cli/patrol.ts bootstrap",
    "admin:recover": "tsx src/cli/patrol.ts admin recover"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@patrol/matching": "workspace:*",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
