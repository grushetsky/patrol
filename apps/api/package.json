{
  "name": "@patrol/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify 5 API serving the contract from @patrol/contract.",
  "bin": {
    "patrol": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "PATROL_PRETTY_LOGS=1 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "cli": "tsx src/cli/index.ts",
    "gen": "echo 'nothing to generate yet; Drizzle Kit generation arrives with the first domain tables'",
    "gen:api": "openapi-typescript ../../contract/generated/openapi/Patrol.openapi.yaml -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@patrol/contract": "workspace:*",
    "@patrol/db": "workspace:*",
    "@patrol/domain": "workspace:*",
    "@patrol/i18n": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
