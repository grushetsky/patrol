    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@patrol/domain": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "5.9.3"
  }
}
