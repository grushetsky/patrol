{
  "name": "@patrol/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure domain primitives shared by the API, the worker, and the web app: the URL deduplication key and the title-text storage normalizer.",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
