# API service image (Fastify 5, docs/adr/0007).
#
# pnpm is installed with npm at the version pinned by packageManager in
# package.json — no Corepack. Workspace manifests are copied first so the
# dependency layer is cached; slice 0 adds the real build script, and the
# entrypoint below is the contract this file keeps.

FROM node:26-slim AS deps
WORKDIR /app
RUN npm install --global pnpm@10.34.9
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY contract/package.json contract/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/evidence/package.json packages/evidence/package.json
COPY packages/mail/package.json packages/mail/package.json
COPY packages/notices/package.json packages/notices/package.json
COPY packages/budget/package.json packages/budget/package.json
COPY packages/scans/package.json packages/scans/package.json
# Every workspace manifest must exist before the filtered install: the
# `@patrol/api...` filter spans the packages above, and pnpm links their
# node_modules only for projects whose package.json it can see here.
RUN pnpm install --frozen-lockfile --filter '@patrol/api...'

FROM deps AS build
COPY . .
RUN pnpm --filter '@patrol/api...' run build

FROM node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 8080
# node:26-slim ships neither curl nor wget, so the probe is plain Node.
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
# The workspace packages ship TypeScript source (their build is
# declaration-only), so the runtime loads them with node's type stripping —
# which does not rewrite the sources' ".js" specifiers to their ".ts" files.
# tsx's loader supplies that resolution; it is pinned in the lockfile and
# installed with the app's devDependencies (present in the runtime image).
CMD ["node", "--import", "file:///app/apps/api/node_modules/tsx/dist/loader.mjs", "apps/api/dist/index.js"]
