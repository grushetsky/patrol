# Worker service image: pg-boss queues and evidence capture against the same
# PostgreSQL as the API (docs/adr/0005). Same layout as Dockerfile.api; no
# HEALTHCHECK because compose does not define one for the worker — liveness is
# the queue heartbeat.

FROM node:26-slim AS deps
WORKDIR /app
RUN npm install --global pnpm@10.34.9
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY contract/package.json contract/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/i18n/package.json packages/i18n/package.json
RUN pnpm install --frozen-lockfile --filter '@patrol/worker...'

FROM deps AS build
COPY . .
RUN pnpm --filter '@patrol/worker...' run build

FROM node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
CMD ["node", "apps/worker/dist/index.js"]
