# Worker service image: pg-boss queues and evidence capture against the same
# PostgreSQL as the API (docs/adr/0005). Same layout as Dockerfile.api. The
# healthcheck watches the heartbeat file the worker touches every 30 s;
# slice 3 replaces it with the queue heartbeat pg-boss provides.

FROM node:26-slim AS deps
WORKDIR /app
RUN npm install --global pnpm@10.34.9
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY contract/package.json contract/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/evidence/package.json packages/evidence/package.json
COPY packages/mail/package.json packages/mail/package.json
COPY packages/notices/package.json packages/notices/package.json
COPY packages/budget/package.json packages/budget/package.json
COPY packages/scans/package.json packages/scans/package.json
# Every workspace manifest must exist before the filtered install: the
# `@patrol/worker...` filter spans the packages above, and pnpm links their
# node_modules only for projects whose package.json it can see here.
RUN pnpm install --frozen-lockfile --filter '@patrol/worker...'

FROM deps AS build
COPY . .
RUN pnpm --filter '@patrol/worker...' run build

FROM node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
# The capture worker drives Playwright's headless Chromium; the browser
# binary and its OS libraries do not ship with the npm package. The version
# is pinned by the lockfile (playwright 1.64.1), so the downloaded browser
# always matches the library in the image.
RUN cd /app/apps/worker && npx --no-install playwright install --with-deps chromium
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD node -e "try { const s = require('node:fs').statSync(process.env.PATROL_WORKER_HEARTBEAT_FILE ?? '/tmp/patrol-worker-heartbeat'); process.exit(Date.now() - s.mtimeMs < 90000 ? 0 : 1) } catch { process.exit(1) }"
# The workspace packages ship TypeScript source (their build is
# declaration-only), so the runtime loads them with node's type stripping —
# which does not rewrite the sources' ".js" specifiers to their ".ts" files.
# tsx's loader supplies that resolution; it is pinned in the lockfile and
# installed with the app's devDependencies (present in the runtime image).
CMD ["node", "--import", "file:///app/apps/worker/node_modules/tsx/dist/loader.mjs", "apps/worker/dist/index.js"]
