# Worker service image: pg-boss queues and evidence capture against the same
# PostgreSQL as the API (docs/adr/0005). Same layout as Dockerfile.api. The
# healthcheck watches the heartbeat file the worker touches every 30 s;
# slice 3 replaces it with the queue heartbeat pg-boss provides.

FROM node:26-slim AS deps
WORKDIR /app
RUN npm install --global pnpm@10.34.9
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY contract/package.json contract/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm install --frozen-lockfile --filter '@patrol/worker...'

FROM deps AS build
COPY . .
RUN pnpm --filter '@patrol/worker...' run build

FROM node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD node -e "try { const s = require('node:fs').statSync(process.env.PATROL_WORKER_HEARTBEAT_FILE ?? '/tmp/patrol-worker-heartbeat'); process.exit(Date.now() - s.mtimeMs < 90000 ? 0 : 1) } catch { process.exit(1) }"
CMD ["node", "apps/worker/dist/index.js"]
