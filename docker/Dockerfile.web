# SSR service image (TanStack Start). Same workspace layout as the other
# services; served on port 3000 and fronted by the ALB for everything that is
# not /api (docs/design/deployment-topology.md).
#
# `vite build` emits the WinterCG fetch entry dist/server/server.js plus
# static assets in dist/client; apps/web/server.mjs is the node:http
# listener that fronts both (the bundle itself binds no port).

FROM node:26-slim AS deps
WORKDIR /app
RUN npm install --global pnpm@10.34.9
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY contract/package.json contract/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/i18n/package.json packages/i18n/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/domain/package.json packages/domain/package.json
COPY packages/evidence/package.json packages/evidence/package.json
COPY packages/mail/package.json packages/mail/package.json
COPY packages/notices/package.json packages/notices/package.json
COPY packages/budget/package.json packages/budget/package.json
COPY packages/scans/package.json packages/scans/package.json
# Every workspace manifest must exist before the filtered install: the
# `@patrol/web...` filter spans the packages above, and pnpm links their
# node_modules only for projects whose package.json it can see here.
RUN pnpm install --frozen-lockfile --filter '@patrol/web...'

FROM deps AS build
COPY . .
RUN pnpm --filter '@patrol/web...' run build

FROM node:26-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app /app
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "apps/web/server.mjs"]
